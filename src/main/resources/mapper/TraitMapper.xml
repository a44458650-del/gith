<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.tft.mapper.TraitMapper">
  <select id="findAll" resultType="TraitVo">SELECT * FROM trait ORDER BY name</select>
  <select id="findById" parameterType="long" resultType="TraitVo">SELECT * FROM trait WHERE id = #{id}</select>
  <insert id="insert" parameterType="TraitVo" useGeneratedKeys="true" keyProperty="id">INSERT INTO trait(name, effect_description) VALUES(#{name}, #{effectDescription})</insert>
  <update id="update" parameterType="TraitVo">UPDATE trait SET name=#{name}, effect_description=#{effectDescription} WHERE id=#{id}</update>
  <delete id="delete" parameterType="long">DELETE FROM trait WHERE id=#{id}</delete>
</mapper>
